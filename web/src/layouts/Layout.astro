---
import '../styles/global.css';
import { LOCALES, i18n } from '../lib/data.js';

const { locale, relPath = '', active = '', title, ogImg } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');   // 確保結尾有 /
// Google Analytics 4：建好資源後把下面換成你的 Measurement ID（G- 開頭）。
// 只在 production build（pnpm build）載入，本機 dev 不送資料。
const GA_ID = 'G-DNK1GL5F3Q';
const T = i18n[locale];
const cur = LOCALES.find((l) => l.code === locale);

const url = (dir, rp) => base + dir + (rp ? rp + '/' : '');
const langUrls = Object.fromEntries(LOCALES.map((l) => [l.code, url(l.dir, relPath)]));
const page = url(cur.dir, '');                    // 當前語系根，給前端組個體連結

const nav = [
  ['', T.nav_home],
  ['pandas', T.nav_search],
  ['zoos', T.nav_zoos],
  ['jptree', T.nav_family],
  ['stats', T.nav_stats],
  ['species', T.nav_species],
];

// Social sharing（OG / Twitter card）：圖與網址必須是絕對 URL（用 astro.config 的 site）
const site = Astro.site?.href.replace(/\/$/, '') ?? 'https://ressapanda.com';
const pageTitle = title ? `${title} | ${T.site_title}` : T.site_title;
const canonicalUrl = site + url(cur.dir, relPath);
// 個體頁可傳 ogImg（相對 base 的路徑，如 og/p/<slug>.png，#22 建置期生成）覆蓋全站共用卡
const ogImage = `${site}${base}${ogImg || 'img/og.png'}`;
// og:locale 要 ll_CC 格式（htmlLang 的 zh-Hant 不符）
const ogLocale = { 'zh-TW': 'zh_TW', 'zh-CN': 'zh_CN', ja: 'ja_JP', en: 'en_US', ko: 'ko_KR' };
---
<!doctype html>
<html lang={cur.htmlLang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {import.meta.env.PROD && GA_ID && !GA_ID.includes('XXXX') && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('config', GA_ID);
      </script>
    </>
  )}
  <script is:inline>document.documentElement.classList.add('js');</script>
  <title>{pageTitle}</title>
  <meta name="description" content={T.site_subtitle} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:site_name" content={T.site_title} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={T.site_subtitle} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={pageTitle} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={ogLocale[locale] ?? cur.htmlLang.replace('-', '_')} />
  {LOCALES.filter((l) => l.code !== locale).map((l) => (
    <meta property="og:locale:alternate" content={ogLocale[l.code] ?? l.htmlLang.replace('-', '_')} />
  ))}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={T.site_subtitle} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={pageTitle} />
  <meta name="theme-color" content="#b5552d" />
  <link rel="icon" href={`${base}icon.svg`} type="image/svg+xml" />
  <link rel="preload" as="font" type="font/woff2" href={`${base}fonts/fredoka-latin.woff2`} crossorigin />
  <script is:inline define:vars={{ base, locale, page, T,
    locales: LOCALES.map((l) => ({ code: l.code, dir: l.dir, label: l.label })), langUrls }}>
    window.BASE = base; window.LOCALE = locale; window.PAGE = page;
    window.T = T; window.LOCALES = locales; window.LANG_URLS = langUrls;
  </script>
  <script is:inline src={`${base}js/lang.js`}></script>
  <script is:inline src={`${base}js/theme.js`}></script>
  <script is:inline src={`${base}js/season.js`}></script>
  <script is:inline src={`${base}js/nav.js`}></script>
  <slot name="head" />
</head>
<body class:list={['font-sans', active === 'home' && 'home']}>
  <!-- 跳至主要內容：鍵盤/螢幕閱讀器使用者可略過 header 導覽，聚焦時才現身 -->
  <a href="#main-content" class="skip-link">{T.skip_to_content}</a>
  <!-- 柔和天空（固定層，全站；裝飾用，輔助技術忽略）-->
  <div class="forest-bg" aria-hidden="true">
    <div class="sky"></div>
  </div>

  <header class="site-header" id="site-header">
    <div class="max-w-4xl mx-auto px-4 py-2.5 sm:py-3 flex items-center gap-x-2 gap-y-1.5 flex-wrap sm:flex-nowrap">
      <!-- brand 給 flex-1 + min-w-0：標題過長（如英文 Red Panda Encyclopedia）時
           在自己的格子內縮小換行，不會把右側按鈕擠到第二行（解多語系手機版跑版） -->
      <a href={page} class="brand order-1 flex-1 font-display font-semibold text-base sm:text-xl no-underline flex items-center gap-2 tracking-wide min-w-0 leading-tight">
        <img src={`${base}icon.svg`} alt="" width="29" height="30" class="anim-bob inline-block shrink-0" /> <span class="min-w-0">{T.site_title}</span>
      </a>
      <div class="order-2 sm:order-3 ml-auto shrink-0 flex items-center gap-1">
        <!-- 季節切換：auto → 春 → 夏 → 秋 → 冬 循環（season.js 換 icon 與 title），
             自動模式圖示稍淡作區別。僅本機 astro dev 顯示（正式站一律自動依日期換季；
             season.js 對按鈕不存在有防呆） -->
        {import.meta.env.DEV && (
          <button id="season-toggle" type="button" aria-label={T.season_toggle}
            class="nav-link inline-flex items-center justify-center leading-none bg-transparent border-0 cursor-pointer p-2 rounded-full text-[16px]">
            <span aria-hidden="true">🍂</span>
          </button>
        )}
        <button id="theme-toggle" type="button" aria-label="切換深色模式"
          class="nav-link inline-flex items-center justify-center leading-none bg-transparent border-0 cursor-pointer p-2 rounded-full">
          <svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
        </button>
        <!-- 語言切換：只顯示地球 icon（隱藏文字），省空間避免手機版 header 換行。
             icon 用 inline SVG + currentColor，跟夜間切換、漢堡選單同樣線條風格、會跟著深色模式變色 -->
        <span class="nav-link relative inline-flex items-center justify-center rounded-full" style="width:38px;height:34px;">
          <svg aria-hidden="true" class="pointer-events-none" width="20" height="20" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9"/><path d="M3 12h18"/>
            <path d="M12 3c2.7 2.9 2.7 15.1 0 18"/><path d="M12 3c-2.7 2.9-2.7 15.1 0 18"/>
          </svg>
          <select id="lang-select" aria-label="Language" title="Language"
            class="absolute inset-0 w-full h-full bg-transparent border-0 cursor-pointer appearance-none"
            style="color:transparent;opacity:0">
            {LOCALES.map((l) => <option value={l.code} lang={l.htmlLang} selected={l.code === locale} style="color:var(--ink)">{l.label}</option>)}
          </select>
        </span>
        <button id="nav-toggle" type="button" aria-label={T.nav_menu ?? '選單'} aria-expanded="false" aria-controls="site-nav"
          class="nav-link sm:hidden inline-flex items-center justify-center leading-none bg-transparent border-0 cursor-pointer p-2 rounded-full">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        </button>
      </div>
      <nav id="site-nav" class="order-3 sm:order-2 w-full sm:w-auto sm:ml-auto hidden sm:flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-1">
        {nav.map(([rp, label]) => (
          <a href={url(cur.dir, rp)}
             class={`nav-link px-3.5 py-1.5 rounded-full text-[.92rem] text-center sm:text-left whitespace-nowrap no-underline ${active === (rp || 'home') ? 'active' : ''}`}>{label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main id="main-content" class:list={['max-w-4xl mx-auto px-4 pb-16', active !== 'home' && 'pt-[var(--header-h,64px)]']}>
    <slot />
    <!-- 頁尾：無卡片，全站直接坐在森林地面上（.site-footer 的文字底暈見 global.css）；
         連結分隔「·」恆顯示避免兩連結黏成一句；meta 拆兩行免得窄版換行難看 -->
    <footer class="site-footer mt-12 text-ink-soft text-[.84rem] px-4 py-3 text-center">
      <div class="flex flex-wrap justify-center items-center gap-x-2.5 gap-y-1">
        <a href={url(cur.dir, 'feedback')} class="text-rust no-underline hover:underline">🐾 {T.feedback_footer_link}</a>
        <span aria-hidden="true" class="opacity-40">·</span>
        <a href={url(cur.dir, 'thanks')} class="text-rust no-underline hover:underline">{T.thanks_footer_link}</a>
      </div>
      <div class="mt-1.5" set:html={T.footer_note}></div>
      <div class="mt-0.5 opacity-80">{T.data_note} {new Date().toISOString().slice(0, 10)}</div>
    </footer>
  </main>
  <!-- 返回頂部：捲動一段距離後於右下角淡入，點擊平滑回到頁首 -->
  <button id="back-to-top" type="button" aria-label={T.back_to_top} title={T.back_to_top} hidden>
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5"/><path d="M5 12l7-7 7 7"/></svg>
  </button>
  <script is:inline>
    (function () {
      var btn = document.getElementById('back-to-top');
      if (!btn) return;
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      function toggle() {
        if (window.scrollY > 400) btn.hidden = false;
        else { btn.hidden = true; btn.classList.remove('show'); return; }
        // 下一幀加 class 觸發淡入過場
        requestAnimationFrame(function () { btn.classList.add('show'); });
      }
      btn.addEventListener('click', function () {
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });
      addEventListener('scroll', toggle, { passive: true });
      toggle();
    })();
  </script>
  <!-- 森林地面：頁面最底（全站共用）-->
  <div class="forest-floor" aria-hidden="true">
    <div class="layer trees"></div>
    <div class="layer fore"></div>
  </div>
  <!-- 量測浮動 header 實際高度 → 寫入 --header-h，內容 offset 永遠跟著它走，
       不受語言／螢幕寬度／header 換行影響（解英文版手機 nav 跑版）-->
  <script is:inline>
    (function () {
      var h = document.getElementById('site-header');
      if (!h) return;
      function setH() {
        document.documentElement.style.setProperty('--header-h', (h.offsetHeight + 4) + 'px');
      }
      setH();
      addEventListener('resize', setH);
      addEventListener('load', setH);
      if (window.ResizeObserver) new ResizeObserver(setH).observe(h);
    })();
  </script>
  <slot name="scripts" />
  <script is:inline src={`${base}js/reveal.js`}></script>
  <script is:inline src="https://unpkg.com/@cobo-screenshot/sdk@1"></script>
  <script is:inline>cobo.init({ workspaceId: "0fb0218a-9bc6-43ef-9916-c6682ebbd64f" })</script>
</body>
</html>
