---
import { pandas, zoos, family, i18n, placeholderMotherName, SHOW_REVIEW, SHOW_IRPD } from '../lib/data.js';
import { pandaUrl, pageUrl } from '../lib/links.js';

const { locale } = Astro.props;
const T = i18n[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
// IRPD 頁五語齊備（2026-08-28）：橫幅整塊連到 /irpd/；SHOW_IRPD 關掉時維持不可點
const irpdLink = SHOW_IRPD;
// 現存數排除存疑個體（unverified：死活/資料未經查證，不當作在世聲明）
const alive = Object.values(pandas).filter((p) => !p.died && !p.unverified).length;
const stats = [
  ['stat-individuals', Object.keys(pandas).length, T.stat_pandas, pageUrl(base, locale, 'pandas')],
  ['stat-alive', alive, T.stat_alive, pageUrl(base, locale, 'pandas') + '?alive=1'],
  ['stat-zoo', zoos.length, T.stat_zoos, pageUrl(base, locale, 'zoos')],
  ['stat-family', family.parent_child.length, T.stat_edges, pageUrl(base, locale, 'stats')],
];
// 今年出生的新寶寶（含蘋果籽佔位）：建置期算，新到舊排序。
// 展示區間（6/1–11/30）由 client 端依訪客當下日期判斷（見 today.js），此處只準備資料。
const thisYear = new Date().getFullYear();
const newborns = Object.values(pandas)
  .filter((p) => p.born && +p.born.slice(0, 4) === thisYear)
  .sort((a, b) => (a.born < b.born ? 1 : a.born > b.born ? -1 : 0));
// 蘋果籽 chip 顯示「{媽媽}的蘋果籽（多胞胎保留號碼）」；非佔位（已命名）沿用正式名。
// 邏輯抽到 data.js 的 placeholderMotherName，與蘋果籽個體頁標題共用。
const newbornLabel = (p) => placeholderMotherName(p, locale);
const H2 = 'font-display text-xl font-semibold mt-9 mb-3 border-l-4 border-amber pl-2.5';
// hero 飄落葉子（裝飾，reduced-motion 下隱藏）
const leaves = [
  { left: '8%', dur: '8.5s', delay: '0s' },
  { left: '26%', dur: '11s', delay: '2.4s' },
  { left: '52%', dur: '9.5s', delay: '1.2s' },
  { left: '72%', dur: '12s', delay: '3.6s' },
  { left: '88%', dur: '10s', delay: '.6s' },
];
---
<!-- ── Hero：全幅森林（融入 header 與背景，底部化入頁面，非卡片）+ 吉祥物 ── -->
<section class="relative mb-3">
  <div class="hero-wrap full-bleed relative">
    <div class="hero-forest">
      <div class="absolute inset-0 overflow-hidden z-[1]" aria-hidden="true">
        {leaves.map((l) => (
          <span class="leaf" style={`left:${l.left};animation-duration:${l.dur};animation-delay:${l.delay}`}></span>
        ))}
      </div>
      <!-- 節氣標示（印章式）：文字由 js/season.js 依日期填入；no-JS 保持 hidden。
           只留大字＋英文 caps（起始日易誤讀為今日日期，2026-07-20 作者裁定移除）。 -->
      <div id="jieqi-mark" class="jieqi-mark" hidden>
        <div class="jq-row">
          <span id="jq-name"></span>
        </div>
        <div id="jq-en" aria-hidden="true"></div>
      </div>
      <img src={`${base}img/mascot-peek.webp`} alt="" width="120" height="120"
           class="anim-float absolute right-[7%] top-[76px] w-[54px] sm:w-[74px] h-auto z-[2]" />
      <div class="absolute left-1/2 -translate-x-1/2 bottom-[14px] sm:bottom-[18px] w-[144px] sm:w-[180px] z-[3]">
        <img src={`${base}img/mascot.webp`} alt={T.site_title} width="480" height="781" fetchpriority="high" class="block w-full h-auto" />
      </div>
    </div>
    <!-- 走路小熊貓：媽媽帶兩隻寶寶，2 格 sprite，沿森林下緣左右來回（CSS 橫移 + 翻面，見 global.css .walker）
         寶寶用 animation-delay 落在同一條 walk-track 稍前的相位，形成跟在後面的小隊 -->
    <div class="walker walker-lead" aria-hidden="true">
      <div class="walker-legs">
        <img src={`${base}img/walk-sheet.webp`} alt="" width="340" height="178" loading="lazy" />
      </div>
    </div>
    <div class="walker walker-cub walker-cub-1" aria-hidden="true">
      <div class="walker-legs">
        <img src={`${base}img/walk-sheet.webp`} alt="" width="340" height="178" loading="lazy" />
      </div>
    </div>
    <div class="walker walker-cub walker-cub-2" aria-hidden="true">
      <div class="walker-legs">
        <img src={`${base}img/walk-sheet.webp`} alt="" width="340" height="178" loading="lazy" />
      </div>
    </div>
  </div>

  <div class="text-center -mt-2 relative z-[4]">
    <h1 class="font-display text-3xl sm:text-4xl font-semibold text-rust-dark mb-1">{T.site_title}</h1>
    <p class="text-ink-soft text-[1.02rem] mb-4">{T.site_subtitle}</p>
    <form action={pageUrl(base, locale, 'pandas')}
          class="flex gap-2.5 flex-wrap items-center justify-center card-soft p-3.5 max-w-2xl mx-auto">
      <input type="search" name="q" placeholder={T.search_placeholder} aria-label={T.search_placeholder}
        class="flex-1 min-w-[220px] bg-card text-ink border border-line rounded-input px-3.5 py-2.5 focus:outline-none focus:border-rust" />
      <button type="submit" class="pop bg-rust text-white rounded-full px-5 py-2.5 text-[.92rem] font-semibold hover:bg-rust-dark">{T.nav_search}</button>
    </form>
  </div>
</section>

<!-- ── 國際小熊貓日倒數（每年 9 月第三個週六）：每年 8/16 起由 today.js 依訪客
     當下日期揭示並填字，當天加 .is-today 慶祝樣式，隔天自動收起。
     比照 #newborns-season：預設 hidden、不加 reveal；no-JS 保持隱藏。 -->
<section id="irpd-banner" class="irpd-banner my-6 px-5 py-3.5 text-center" hidden>
  <a href={irpdLink ? pageUrl(base, locale, 'irpd') : undefined}
     class={irpdLink ? 'block no-underline text-inherit' : 'block'}>
  <div class="flex items-center justify-center gap-2">
    <p id="irpd-text" class="font-display font-semibold text-rust-dark text-[1.08rem] m-0"></p>
    <!-- logo 尾巴（同 header 品牌 icon）：flex 排版跟在標題字尾，五語寬度自動適應、
         絕不壓字；左右翻轉＝外層 span scaleX、內層 img 跑 anim-bob（兩層 transform
         才不互蓋）；節奏與 header 錯開，見 .irpd-tail -->
    <span class="irpd-tail" aria-hidden="true">
      <img src={`${base}icon.svg`} alt="" width="29" height="30" loading="lazy" class="anim-bob" />
    </span>
  </div>
  <p id="irpd-sub" class="text-ink-soft text-[.82rem] m-0 mt-1"></p>
  </a>
</section>

<!-- ── 數字徽章 ─────────────────────────────────────────────── -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-6">
  {stats.map(([icon, n, l, href]) => (
    <a href={href} class="stat-card py-4 px-2">
      <img src={`${base}img/${icon}.webp`} alt="" aria-hidden="true" width="96" height="96" loading="lazy"
           class="stat-icon w-12 h-12 mx-auto mb-1.5 object-contain" />
      <div class="text-3xl font-display font-semibold text-rust leading-none">{n}</div>
      <div class="text-[.82rem] text-ink-soft mt-1.5">{l}</div>
    </a>
  ))}
</div>

<!-- ── 新鮮的寶寶（展示區間 6/1–11/30 由 today.js 依當下日期揭示；預設 hidden） ── -->
<section id="newborns-season" hidden>
  <h2 class={H2}>{T.home_newborns}</h2>
  <div class="card-soft p-5">
    {newborns.length > 0 ? (
      <Fragment>
        <p class="flex flex-wrap gap-2 mb-3.5">
          {newborns.map((p) => (
            <a href={pandaUrl(base, locale, p.urlId)}
               class="pop inline-flex items-baseline gap-1.5 bg-cream border border-line rounded-full px-4 py-2 text-[.94rem] no-underline hover:border-amber">
              <span class="font-display font-semibold">{p.placeholder && <span aria-hidden="true">🍎 </span>}{newbornLabel(p)}{p.died && <span role="img" aria-label={T.deceased} class="ml-1">{T.deceased_mark}</span>}</span>
              <span class="text-[.8rem] text-ink-soft">{p.born.slice(5).replace('-', '/')}</span>
            </a>
          ))}
        </p>
        <p class="text-ink-soft text-[.85rem] m-0 leading-relaxed">{T.home_newborns_note}</p>
      </Fragment>
    ) : (
      <p class="text-ink-soft text-[.95rem] m-0"><span aria-hidden="true">🍎</span> {T.home_newborns_empty}</p>
    )}
  </div>
</section>

<!-- ── 今天 ─────────────────────────────────────────────────── -->
<section class="reveal">
  <h2 class={H2}>{T.today_title}</h2>
  <div class="card-soft p-5">
    <h3 class="font-display text-base mb-2.5 text-rust-dark">{T.today_birthdays}</h3>
    <div id="today-birthdays" class="flex flex-wrap gap-2 mb-4"></div>
    <h3 class="font-display text-base mb-2.5 text-rust-dark">{T.today_rainbow}</h3>
    <div id="today-rainbow" class="flex flex-wrap gap-2"></div>
    <!-- 年度回顧入口（top-level nav 已滿，見 nav-japan-group 裁定；從紀念日卡連過去最順）。
         SHOW_REVIEW：公開前只在 dev 顯示（見 data.js 開關註解） -->
    {SHOW_REVIEW && (
      <p class="text-[.88rem] mt-4 mb-0"><a class="text-rust font-semibold no-underline hover:underline" href={pageUrl(base, locale, 'review')}>🪐 {T.rv_title} →</a></p>
    )}
  </div>
</section>

<!-- ── 今日休園（JST）：由 js/closed.js 依 closed_rule 計算並揭示；
     今日無休園整個區塊保持 hidden（比照 #newborns-season，不加 reveal） ── -->
<section id="today-closed-wrap" hidden>
  <h2 class={H2}>{T.today_closed}</h2>
  <div class="card-soft p-5">
    <div id="today-closed" class="flex flex-wrap gap-2 mb-3"></div>
    <p class="text-ink-soft text-[.85rem] m-0 leading-relaxed">{T.today_closed_note}</p>
  </div>
</section>

<!-- ── 關於本站（短版）：非營利同好專案宣言，連到 /thanks/ 的完整版＋致謝名單 ── -->
<section class="reveal mt-9">
  <div class="card-soft p-5 text-center">
    <p class="text-ink-soft leading-relaxed m-0 mb-2.5">🐾 {T.home_about_text}</p>
    <a href={pageUrl(base, locale, 'thanks')}
       class="text-rust font-semibold no-underline hover:underline">{T.about_title} →</a>
  </div>
</section>
