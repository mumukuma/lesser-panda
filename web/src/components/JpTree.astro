---
import { i18n, japanTreeData } from '../lib/data.js';
const { locale } = Astro.props;
const T = i18n[locale];
// 介紹文的隻數／世代數建置期自動帶入（與右上角統計同一資料來源），
// 新增日本家系成員重建後即自動更新，毋須手改 ft_intro。
const _D = japanTreeData(locale);
const intro = (T.ft_intro || '').replace('{n}', _D.jpCount).replace('{g}', _D.maxg + 1);
---
<h1 class="font-display text-2xl font-semibold mt-7 mb-1.5">{T.nav_family}</h1>
<p class="text-ink-soft text-[.9rem] leading-relaxed mb-3 max-w-2xl">{intro}</p>

<div class="ft-tools">
  <input id="ft-search" type="text" list="ft-names" autocomplete="off" placeholder={T.ft_search} aria-label={T.ft_search} />
  <datalist id="ft-names"></datalist>
  <select id="ft-zoo" aria-label={T.ft_zoo_filter} title={T.ft_zoo_filter}>
    <option value="">{T.ft_zoo_all}</option>
  </select>
  <button id="ft-reset" type="button">{T.ft_reset}</button>
  <span id="ft-stat" class="ft-stat"></span>
</div>

<div class="ft-stage">
  <svg id="ft-svg" role="img" aria-label={T.nav_family} xmlns="http://www.w3.org/2000/svg"></svg>
  <div id="ft-coach"><span>{T.ft_focus_tip}</span><button id="ft-coach-x" type="button" aria-label="×">×</button></div>
  <div id="ft-info"></div>
  <div class="ft-legend">
    <span><i class="sw female"></i>♀</span>
    <span><i class="sw male"></i>♂</span>
    <span><i class="sw living"></i>{T.ft_alive}</span>
    <span><i class="sw gone"></i>{T.ft_dead}</span>
    <span><i class="sw overseas"></i>{T.ft_overseas}</span>
    <span class="hint">{T.ft_hint}</span>
  </div>
</div>

<style is:global>
  .ft-tools { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 6px 0 10px; }
  .ft-tools input, .ft-tools select, .ft-tools button {
    font: inherit; font-size: .88rem; padding: 7px 10px; border: 1px solid var(--line);
    border-radius: 9px; background: var(--bg-card); color: var(--ink); }
  .ft-tools input { width: 170px; }
  /* 原生 select 的內建寬度跟著最長 option 走（英／韓園名可到 466px），在窄螢幕會把整頁
     撐出橫向捲動。設 max-width＋min-width:0 讓它縮在工具列內，選單展開時仍顯示全名。 */
  .ft-tools select { max-width: 100%; min-width: 0; }
  .ft-tools button { cursor: pointer; color: var(--ink-soft); }
  .ft-tools button:hover { color: var(--rust-dark); }
  .ft-stat { font-size: .8rem; color: var(--ink-soft); margin-left: auto; }

  /* 畫布做滿版（full-bleed）：標題／工具列仍在文字欄，只有這塊吃滿螢幕寬。
     依賴全站 html{overflow-x:clip}，100vw 不會產生橫向捲動。 */
  .ft-stage { position: relative; height: 82vh; min-height: 440px; overflow: hidden;
    background: var(--canvas);   /* 共用畫布色：摻當前天空色，跟著四季／節氣（深淺模式皆由變數處理） */
    width: 100vw; margin-left: calc(50% - 50vw);
    border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  @media (max-width: 560px) { .ft-stage { height: 72vh; } .ft-tools input { width: 130px; } }

  /* touch-action/user-select 掛在 svg 而非 stage：底部資訊卡才能正常捲動 */
  #ft-svg { display: block; width: 100%; height: 100%; cursor: grab;
    touch-action: none; user-select: none; }
  #ft-svg.grab { cursor: grabbing; }

  /* 連線：中性暖褐（共用 --edge，比照個體頁家系圖 .tree-link），高亮才轉鏽紅 */
  .ft-edge { stroke: var(--edge); stroke-width: 1.3; fill: none; opacity: .75; }
  .ft-edge.on { stroke: var(--rust); stroke-width: 2; opacity: 1; }
  .ft-edge.faded { opacity: .06; }

  /* 節點：奶油底、邊框依性別上色（沿用全站 --female／--male，與個體頁一致）；
     已歿＝虛線邊框＋略淡，不再用綠色區分 */
  .ft-node { cursor: pointer; }
  .ft-node rect { fill: var(--bg-card); stroke: var(--line); stroke-width: 1.3; }
  .ft-node.f rect { stroke: var(--female); }
  .ft-node.m rect { stroke: var(--male); }
  .ft-node.dead { opacity: .8; }
  .ft-node.dead rect { stroke-dasharray: 3 2.5; }
  .ft-node .ft-nm { font-size: 12px; fill: var(--ink); pointer-events: none; }
  .ft-node .ft-sub { font-size: 9px; fill: var(--ink-soft); pointer-events: none; }
  .ft-node.faded { opacity: .12; }
  /* 海外個體：本身沒住過日本，只是把日本個體的祖先線接起來的脈絡節點。
     邊框改中性灰虛線、整體弱化，性別色讓給真正的日本成員。 */
  .ft-node.os { opacity: .5; }
  .ft-node.os rect { stroke: var(--ink-soft); stroke-dasharray: 2 3; fill: var(--bg); }
  .ft-node.os .ft-dot { fill: var(--ink-soft); }
  .ft-node.os.hl, .ft-node.os.ca { opacity: 1; }
  /* 聚焦本熊：琥珀底＋光暈（比照個體頁中心節點），性別框色保留 */
  .ft-node.hl rect { fill: color-mix(in srgb, var(--amber) 24%, var(--bg-card)); stroke-width: 2.6;
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--amber) 60%, transparent)); }
  .ft-node.hl:not(.f):not(.m) rect { stroke: var(--amber); }
  .ft-node.hl .ft-dot { fill: var(--amber); }
  /* 兩隻比較模式：最近共同祖先節點（鏽紅底標記） */
  .ft-node.ca rect { fill: color-mix(in srgb, var(--rust) 15%, var(--bg-card)); stroke-width: 2.2;
    filter: drop-shadow(0 0 3px color-mix(in srgb, var(--rust) 45%, transparent)); }
  .ft-node.ca:not(.f):not(.m) rect { stroke: var(--rust); }
  .ft-genlbl { font-size: 22px; font-weight: 700; fill: var(--rust); opacity: .5; pointer-events: none; }

  /* 遠景圓點：依性別上色，已歿較淡 */
  .ft-dot { display: none; fill: var(--ink-soft); }
  .ft-node.f .ft-dot { fill: var(--female); }
  .ft-node.m .ft-dot { fill: var(--male); }
  .ft-node.dead .ft-dot { opacity: .55; }
  /* 細節層級（level-of-detail）：由縮放決定畫布 class */
  #ft-svg.lod-far .ft-node rect,
  #ft-svg.lod-far .ft-node text { display: none; }
  #ft-svg.lod-far .ft-node .ft-dot { display: block; }
  #ft-svg.lod-mid .ft-node .ft-sub { display: none; }
  /* 血脈聚焦模式：隱藏非血脈節點/連線與世代色帶，只留一棵乾淨小樹 */
  .ft-hidden { display: none; }
  #ft-svg.focus .ft-bands { display: none; }
  /* 聚焦時節點少，一律顯示完整標籤（覆寫 LOD） */
  #ft-svg.focus.lod-far .ft-node rect,
  #ft-svg.focus.lod-far .ft-node text,
  #ft-svg.focus.lod-mid .ft-node .ft-sub { display: block; }
  #ft-svg.focus .ft-node .ft-dot { display: none; }

  /* 落地引導提示條 */
  #ft-coach { position: absolute; top: 12px; left: 12px; right: 12px; display: flex; align-items: center;
    gap: 10px; max-width: 460px; margin: 0 auto; background: color-mix(in srgb, var(--bg-card) 94%, transparent);
    border: 1px solid var(--line); border-radius: 11px; padding: 9px 12px; font-size: .82rem;
    color: var(--ink-soft); box-shadow: var(--shadow); z-index: 3; }
  #ft-coach span { flex: 1; line-height: 1.45; }
  #ft-coach button { flex: none; border: none; background: none; color: var(--ink-soft); cursor: pointer;
    font-size: 1.1rem; line-height: 1; padding: 0 2px; }
  #ft-coach button:hover { color: var(--rust-dark); }

  #ft-info { position: absolute; top: 12px; right: 12px; width: 210px; display: none;
    background: var(--bg-card); border: 1px solid var(--line); border-radius: 11px;
    padding: 11px 13px; font-size: .82rem; box-shadow: var(--shadow); }
  #ft-info h2 { margin: 0 0 6px; font-size: 1rem; }
  #ft-info .row { display: flex; justify-content: space-between; gap: 8px; padding: 2px 0; color: var(--ink-soft); }
  #ft-info .row b { color: var(--ink); font-weight: 600; }
  #ft-info .ft-open { display: inline-block; margin-top: 8px; color: var(--rust); text-decoration: none; font-weight: 600; }
  #ft-info .ft-open:hover { text-decoration: underline; }
  #ft-info button { margin-top: 8px; margin-left: 10px; border: 1px solid var(--line);
    background: var(--bg); color: var(--ink-soft); border-radius: 7px; padding: 4px 9px; font-size: .78rem; cursor: pointer; }

  .ft-legend { position: absolute; left: 12px; bottom: 12px; display: flex; flex-wrap: wrap;
    align-items: center; gap: 4px 12px; max-width: calc(100% - 24px);
    background: color-mix(in srgb, var(--bg-card) 88%, transparent); border: 1px solid var(--line);
    border-radius: 10px; padding: 7px 11px; font-size: .76rem; color: var(--ink-soft); }
  .ft-legend .sw { display: inline-block; width: 12px; height: 12px; border-radius: 3px; vertical-align: -1px; margin-right: 5px; }
  .ft-legend .sw.female { background: color-mix(in srgb, var(--female) 16%, var(--bg-card)); border: 1px solid var(--female); }
  .ft-legend .sw.male { background: color-mix(in srgb, var(--male) 16%, var(--bg-card)); border: 1px solid var(--male); }
  .ft-legend .sw.overseas { background: var(--bg); border: 1px dashed var(--ink-soft); opacity: .6; }
  .ft-legend .sw.living { background: var(--bg-card); border: 1px solid var(--ink-soft); }
  .ft-legend .sw.gone { background: var(--bg-card); border: 1px dashed var(--ink-soft); }
  .ft-legend .hint { opacity: .8; }
  @media (max-width: 560px) {
    .ft-legend .hint { display: none; }
    /* 手機版：資訊卡改為滿版底部卡片（bottom sheet），字級放大、可捲動；
       視野由 jptree.js 的 fitBox inset 自動避開卡片高度 */
    #ft-info { top: auto; right: 0; left: 0; bottom: 0; width: auto; max-height: 45%;
      overflow-y: auto; -webkit-overflow-scrolling: touch; touch-action: pan-y;
      border-radius: 14px 14px 0 0; border-bottom: none; border-left: none; border-right: none;
      padding: 12px 16px calc(12px + env(safe-area-inset-bottom)); font-size: .92rem; z-index: 4; }
    #ft-info h2 { font-size: 1.08rem; }
    #ft-info button { font-size: .85rem; padding: 6px 12px; }
    /* 卡片打開時圖例讓位（同樣佔底部） */
    .ft-stage.has-info .ft-legend { display: none; }
  }
</style>
