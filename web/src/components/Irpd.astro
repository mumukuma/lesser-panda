---
/* 國際小熊貓日（/irpd/）：這天的由來、日本各園的過法、Red Panda Network 介紹。
   規劃見 docs/irpd-page-PLAN.md，中文正本為 repo 根的 irpd-intro.md。

   內容字串全在 i18n 的 irpd_* key（五語，2026-08-28 從 lib/irpd-content.js 搬入並公開）；
   本檔只放版面與語系無關的常數（園 id、官方連結）。日文引用一律逐字，中／英／韓語版
   包在 <span lang="ja"> 裡（字型依 lang 切換），ja 版則直接寫在句中。

   ⚠️ 活動日期與當年出生數一律走 {date}／{year}／{n}／{seeds} token（data.js 的 IRPD 建置期算），
   不可寫死在文案裡，否則跨年即錯。

   季節段（今年的寶寶）預設 hidden，由 public/js/irpd.js 依訪客當下日期揭示，
   同首頁 #newborns-season 的理由：deploy 無 cron，建置期判斷會過期。

   增補代表例＝EXAMPLES 加一筆（zoo＝zoos.json 的 id）＋五語各補一組 irpd_zoo_<id> 描述句。 */
import { i18n, IRPD, zooName, zooSlugById } from '../lib/data.js';
import { pageUrl, zooUrl } from '../lib/links.js';

const { locale } = Astro.props;
const T = i18n[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const H2 = 'font-display text-xl font-semibold mt-9 mb-3 border-l-4 border-amber pl-2.5';
const H3 = 'font-display font-semibold mt-6 mb-2';
const A = 'text-rust hover:underline';

const a = (rp, label) => `<a class="${A}" href="${pageUrl(base, locale, rp)}">${label}</a>`;
const ext = (url, label) => `<a class="${A}" href="${url}" target="_blank" rel="noopener">${label}</a>`;

// 代表例：語系無關（園名由 zooName() 依語系帶出、描述句走 irpd_zoo_<id>）
const EXAMPLES = [
  { zoo: 45, url: 'https://www.city.sendai.jp/zoo/' },
  { zoo: 12, url: 'https://www.hama-midorinokyokai.or.jp/zoo/zoorasia/' },
  { zoo: 26, url: 'https://www.city.akita.lg.jp/zoo/news/1008854/1053175.html' },
  { zoo: 15, url: 'https://ikedazoo.jp/event/%e5%9b%bd%e9%9a%9b%e3%83%ac%e3%83%83%e3%82%b5%e3%83%bc%e3%83%91%e3%83%b3%e3%83%80%e3%83%87%e3%83%bc2026/' },
];

// 站內連結／建置期數字 placeholder（同 Species.astro 的 link() 模式，但一次掃完所有 token——
// String.replace 吃字串只換第一個，{year} 在同段出現兩次時會漏）
const TOK = {
  species: a('species', T.nav_species),
  zoos: a('zoos', T.nav_zoos),
  feedback: a('feedback', T.nav_feedback),
  getinvolved: ext('https://redpandanetwork.org/get-involved', 'Get Involved'),
  rpn: ext('https://redpandanetwork.org/', 'Red Panda Network'),
  rpnig: ext('https://www.instagram.com/redpandanetwork/', 'Red Panda Network'),
  yagiyama: zooName(45, null, locale),      // s2_p3 引仙台市八木山動物公園的官方說法
  t1: '<code>#InternationalRedPandaDay</code>',
  t2: '<code lang="ja">#国際レッサーパンダデー</code>',
  n: String(IRPD.n),
  seeds: String(IRPD.seeds),
  year: String(IRPD.year),
  date: IRPD.date,
};
const link = (s) => String(s).replace(/\{(\w+)\}/g, (m, k) => (k in TOK ? TOK[k] : m));

const LIST = [1, 2, 3, 4, 5];
const RELATED = [['zoos', T.nav_zoos, T.irpd_s5_zoos], ['species', T.nav_species, T.irpd_s5_species], ['feedback', T.nav_feedback, T.irpd_s5_feedback]];
---
<h1 class="font-display text-3xl font-semibold mt-6 mb-1">{T.irpd_title}</h1>

<h2 class={H2}>{T.irpd_s1_title}</h2>
<p class="leading-relaxed mb-3" set:html={link(T.irpd_s1_p1)} />
<p id="irpd-season" class="leading-relaxed mb-3" data-seeds={IRPD.seeds} hidden set:html={link(T.irpd_s1_season)} />

<h2 class={H2}>{T.irpd_s2_title}</h2>
<p class="leading-relaxed mb-3" set:html={link(T.irpd_s2_p1)} />
<p class="leading-relaxed mb-3" set:html={link(T.irpd_s2_p2)} />
<p class="leading-relaxed mb-3" set:html={link(T.irpd_s2_p3)} />

<h2 class={H2}>{T.irpd_s3_title}</h2>
<p class="leading-relaxed mb-3" set:html={link(T.irpd_s3_p1)} />
<ol class="list-decimal pl-5 leading-relaxed mb-3">
  {LIST.map((i) => (
    <li class="mb-2"><strong>{T['irpd_s3_l' + i + '_label']}</strong> — <span set:html={link(T['irpd_s3_l' + i + '_body'])} /></li>
  ))}
</ol>
<p class="leading-relaxed mb-3" set:html={link(T.irpd_s3_note)} />

<h3 class={H3}>{T.irpd_s3_ex_title}</h3>
{EXAMPLES.map((e) => (
  <p class="leading-relaxed mb-3">
    <strong><a class={A} href={zooUrl(base, locale, zooSlugById[e.zoo])}>{zooName(e.zoo, null, locale)}</a></strong>
    <span class="text-ink-soft text-[.86rem]"> （<a class={A} href={e.url} target="_blank" rel="noopener">{T.zoo_website}</a>）</span>
    <span> — </span><span set:html={link(T['irpd_zoo_' + e.zoo])} />
  </p>
))}

<p class="leading-relaxed mb-3" set:html={link(T.irpd_s3_cta)} />

<h2 class={H2}>{T.irpd_s4_title}</h2>
<p class="leading-relaxed mb-3" set:html={link(T.irpd_s4_p1)} />
<p class="leading-relaxed mb-3" set:html={link(T.irpd_s4_p2)} />
<p class="leading-relaxed mb-3" set:html={link(T.irpd_s4_p3)} />
<p class="leading-relaxed mb-3" set:html={link(T.irpd_s4_p4)} />

<h3 class={H3}>{T.irpd_s4_support_title}</h3>
<p class="leading-relaxed mb-3" set:html={link(T.irpd_s4_support_p)} />
<p class="card-soft p-4 text-ink-soft text-[.9rem] leading-relaxed">{T.irpd_s4_disclaimer}</p>

<h2 class={H2}>{T.irpd_s5_title}</h2>
<ul class="list-disc pl-5 leading-relaxed">
  {RELATED.map(([rp, label, desc]) => (
    <li class="mb-1.5">
      <a class={A} href={pageUrl(base, locale, rp)}>{label}</a> — {desc}
    </li>
  ))}
  <li class="mb-1.5" set:html={link(T.irpd_s5_tags)} />
</ul>
