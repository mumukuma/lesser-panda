---
/* 資料使用條款（/terms/，footer 入口）：自訂「保留所有權利」條款，五語 i18n（terms_*）。
   {feedback}…{/feedback} 成對 token 同 Thanks.astro 模式，連到回報表單。 */
import { i18n } from '../lib/data.js';
import { pageUrl } from '../lib/links.js';
const { locale } = Astro.props;
const T = i18n[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const H2 = 'font-display text-xl font-semibold mt-9 mb-3 border-l-4 border-amber pl-2.5';

const open = (rp) => `<a class="text-rust hover:underline" href="${pageUrl(base, locale, rp)}">`;
const link = (s) => s.replace('{feedback}', open('feedback')).replace('{/feedback}', '</a>');
---
<h1 class="font-display text-2xl font-semibold mt-7 mb-3">📜 {T.terms_title}</h1>
<p class="leading-relaxed mb-3">{T.terms_p1}</p>

<h2 class={H2}>{T.terms_ok_title}</h2>
<p class="leading-relaxed mb-3">{T.terms_ok_p1}</p>

<h2 class={H2}>{T.terms_no_title}</h2>
<ul class="list-disc pl-6 leading-relaxed mb-3 space-y-1">
  <li>{T.terms_no_1}</li>
  <li>{T.terms_no_2}</li>
  <li>{T.terms_no_3}</li>
</ul>

<h2 class={H2}>{T.terms_research_title}</h2>
<p class="leading-relaxed mb-3" set:html={link(T.terms_research_p1)} />

<h2 class={H2}>{T.terms_embed_title}</h2>
<p class="leading-relaxed mb-3">{T.terms_embed_p1}</p>

<p class="text-ink-soft text-[.9rem] leading-relaxed mt-8">{T.terms_src_p1}</p>
<p class="text-ink-soft text-[.9rem] leading-relaxed mt-2">{T.terms_updated}</p>
