---
/* 統計儀表板（#17）：全部由 pipeline/data 於建置期計算，純 HTML/CSS 長條圖、零 JS 零圖表庫。
   顏色一律走主題 CSS 變數 → 深色模式自動成立。僅統計日期已知的個體（見頁尾註）。 */
import { pandas, i18n, displayName, zooName, zooSlugById, deceasedHtml, SHOW_REVIEW, bornAtFirstZoo } from '../lib/data.js';
import { pandaUrl, pageUrl, zooUrl } from '../lib/links.js';

const { locale } = Astro.props;
const T = i18n[locale];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

// 存疑個體（unverified）整頁不列入：資料未經查證，不當作在世或出生聲明
const all = Object.values(pandas).filter((p) => !p.unverified);
const living = all.filter((p) => !p.died);
const now = new Date();

// 日期工具：只有年份取年中、年月取月中（與個體頁時間軸同一套近似）
const toDate = (s) => {
  if (!s) return null;
  const v = /^\d{4}$/.test(s) ? s + '-07-01' : /^\d{4}-\d{2}$/.test(s) ? s + '-15' : s;
  const d = new Date(v);
  return isNaN(d) ? null : d;
};
const yearsBetween = (a, b) => (b - a) / 31557600000;

// ── 每年出生數（2026-08-15 起依性別、♀ 左 ♂ 右金字塔）────────
// 第一版做成堆疊直條，維護者當日改判「難讀」→ 改與「年齡分布」同一套讀法：
// 一年一列、年份置中、數字標兩側，最近年在最上（與各排行的新→舊同讀向），
// 手機不必橫向捲。性別待確認（全庫 15 筆）不入圖，tooltip＋註腳交代。
const byYear = {};
for (const p of all) if (p.born) {
  const y = +p.born.slice(0, 4);
  const e = byYear[y] || (byYear[y] = { f: 0, m: 0, u: 0 });
  e[p.sex === 'female' ? 'f' : p.sex === 'male' ? 'm' : 'u']++;
}
const yrs = Object.keys(byYear).map(Number);
const yearSeries = []; // [y, ♀, ♂, 待確認, 合計]（新→舊）
for (let y = Math.max(...yrs); y >= Math.min(...yrs); y--) {
  const e = byYear[y] || { f: 0, m: 0, u: 0 };
  yearSeries.push([y, e.f, e.m, e.u, e.f + e.m + e.u]);
}
const yearBandMax = Math.max(...yearSeries.map((r) => Math.max(r[1], r[2])), 1);
const birthTot = yearSeries.reduce((s, r) => ({ f: s.f + r[1], m: s.m + r[2], u: s.u + r[3] }), { f: 0, m: 0, u: 0 });
// 49 列太長（2026-08-15 維護者裁定）：預設只列近 20 年，更早收進原生 <details>（零 JS，
// 同園頁完整資料表的作法）。兩段共用同一個 yearBandMax，展開後長條比例才可直接互比。
const RECENT_YEARS = 20;
const yearRecent = yearSeries.slice(0, RECENT_YEARS);
const yearEarlier = yearSeries.slice(RECENT_YEARS);
const earlierTot = yearEarlier.reduce((s, r) => s + r[4], 0);
const yearTip = (y, f, m, u, tt) =>
  `${y}｜${tt}（${T.sex_f} ${f}・${T.sex_m} ${m}${u ? '・' + T.sex_unknown + ' ' + u : ''}）`;

// ── 排行截斷：取前 N 名，與第 N 名同數者一併列入（不讓並列被任意切掉），
//    並給競賽式名次（同數同名次）。回傳 [item, rank] 陣列。
const rankCut = (arr, n, val) => {
  let cut = arr;
  if (arr.length > n) {
    const t = val(arr[n - 1]);
    let i = n;
    while (i < arr.length && val(arr[i]) === t) i++;
    cut = arr.slice(0, i);
  }
  let prev, rank = 0;
  return cut.map((x, i) => {
    const v = val(x);
    if (v !== prev) { rank = i + 1; prev = v; }
    return [x, rank];
  });
};

// ── 出生寶寶數最多的動物園（前 15 名，同數並列一併列入）──────
// 出生地＝第一段居住史的園，且該首站確為出生園（data.js 的 bornAtFirstZoo，與 gen_residence 的 🐣 同一定義）
// ⚠️ 野生輸入／來源不明個體的首站只是「來日後的第一座園」，不可計入該園的出生數。
const birthCount = new Map();
for (const p of all) {
  const r0 = (p.residences || [])[0];
  if (!r0 || !bornAtFirstZoo(p)) continue;
  const key = r0.zoo_id ?? (r0.zoo_raw || null);
  if (key !== null) birthCount.set(key, (birthCount.get(key) || 0) + 1);
}
const birthRank = [...birthCount.entries()].sort((a, b) => b[1] - a[1]);
const topBirth = rankCut(birthRank, 15, ([, n]) => n);
const restBirth = birthRank.slice(topBirth.length).reduce((s, [, n]) => s + n, 0);
const birthMax = Math.max(...topBirth.map(([[, n]]) => n), 1);

// ── 各動物園現居頭數（前 15 名＋其他，同數並列一併列入）────
const zooCount = new Map();
for (const p of living) {
  const key = p.current_zoo ?? (p.current_zoo_raw || null);
  if (key !== null) zooCount.set(key, (zooCount.get(key) || 0) + 1);
}
const zooRank = [...zooCount.entries()].sort((a, b) => b[1] - a[1]);
const topZoos = rankCut(zooRank, 15, ([, n]) => n);
const restZoos = zooRank.slice(topZoos.length).reduce((s, [, n]) => s + n, 0);
const zooMax = Math.max(...topZoos.map(([[, n]]) => n), 1);
const zoosHref = pageUrl(base, locale, 'zoos');

// ── 年齡分布（現存、性別已知；年齡以生日估算）──────────────
const ageOf = (p) => {
  const b = toDate(p.born);
  return b ? Math.max(0, Math.floor(yearsBetween(b, now))) : null;
};
const BAND = 2;
const bands = []; // [label, f, m]
for (const p of living) {
  if (p.sex !== 'female' && p.sex !== 'male') continue;
  const a = ageOf(p);
  if (a === null) continue;
  const bi = Math.min(Math.floor(a / BAND), 10); // 20+ 併一格
  while (bands.length <= bi) {
    const lo = bands.length * BAND;
    bands.push([bands.length >= 10 ? '20+' : `${lo}–${lo + BAND - 1}`, 0, 0]);
  }
  bands[bi][p.sex === 'female' ? 1 : 2]++;
}
const bandMax = Math.max(...bands.map(([, f, m]) => Math.max(f, m)), 1);

// ── 母獸產仔年齡（母子雙方生日皆已知者；依生日估算）──────────
//    生日在兩邊都記得很完整，故此分布不受「夭折仔未收錄」影響（已與國際血統書對照，
//    最年輕／中位數／最年長三個值均吻合）。
const _med = (xs) => {
  const a = [...xs].sort((x, y) => x - y);
  return a.length % 2 ? a[(a.length - 1) / 2] : (a[a.length / 2 - 1] + a[a.length / 2]) / 2;
};
const f1 = (x) => (Math.round(x * 10) / 10).toFixed(1);
const damAges = [];
const damSet = new Set();
for (const p of all) {
  if (!p.mother) continue;
  const m = pandas[p.mother];
  if (!m || m.unverified) continue;
  const b = toDate(p.born), mb = toDate(m.born);
  if (!b || !mb) continue;
  const a = yearsBetween(mb, b);
  if (a > 0 && a < 30) { damAges.push(a); damSet.add(p.mother); }
}
const ageBins = (ages) => {
  const bins = [];
  for (const a of ages) {
    const i = Math.floor(a);
    while (bins.length <= i) bins.push(0);
    bins[i]++;
  }
  return bins.map((n, i) => [i, n]).filter(([i]) => i >= 1);
};
const damSeries = ageBins(damAges);
const damPeak = Math.max(...damSeries.map(([, n]) => n), 1);
const damNote = damAges.length ? T.stats_dam_age_note
  .replace('{n}', damAges.length).replace('{d}', damSet.size)
  .replace('{min}', f1(Math.min(...damAges))).replace('{med}', f1(_med(damAges)))
  .replace('{max}', f1(Math.max(...damAges))) : '';

// ── 父獸產仔年齡（2026-08-15 新增，與母獸並排；同樣雙方生日已知才計）────
const sireAges = [];
const sireSet = new Set();
for (const p of all) {
  if (!p.father) continue;
  const s = pandas[p.father];
  if (!s || s.unverified) continue;
  const b = toDate(p.born), sb = toDate(s.born);
  if (!b || !sb) continue;
  const a = yearsBetween(sb, b);
  if (a > 0 && a < 30) { sireAges.push(a); sireSet.add(p.father); }
}
const sireSeries = ageBins(sireAges);
const sirePeak = Math.max(...sireSeries.map(([, n]) => n), 1);
const sireNote = sireAges.length ? T.stats_sire_age_note
  .replace('{n}', sireAges.length).replace('{d}', sireSet.size)
  .replace('{min}', f1(Math.min(...sireAges))).replace('{med}', f1(_med(sireAges)))
  .replace('{max}', f1(Math.max(...sireAges))) : '';

// ── 歿齡分布（已故且生日／歿日皆已知者）──────────────────
//    ⚠️ 這是「歿齡組成」不是存活率：未滿一歲夭折者多半沒有條目（國際血統書裡約四分之一
//    的幼獸活不過第一年，本站只有 2% 上下），註腳已說明，勿改寫成「壽命／存活率」。
//    2026-08-15 起分性別：♀ 左 ♂ 右金字塔（與上方年齡分布同讀法），2 歲一格、24+ 併格。
//    全庫歿日已知者性別已知率 100%（實測 0 隻不明），故金字塔不漏樣本；註腳補兩性中位數。
const deathAges = [];
const dBands = []; // [label, ♀, ♂]
const dSex = { f: [], m: [] };
for (const p of all) {
  if (!p.died) continue;
  const b = toDate(p.born), d = toDate(p.died);
  if (!b || !d) continue;
  const a = yearsBetween(b, d);
  if (a < 0 || a >= 40) continue;
  deathAges.push(a);
  if (p.sex !== 'female' && p.sex !== 'male') continue;
  const bi = Math.min(Math.floor(a / BAND), 12);
  while (dBands.length <= bi) {
    const lo = dBands.length * BAND;
    dBands.push([dBands.length >= 12 ? '24+' : `${lo}–${lo + BAND - 1}`, 0, 0]);
  }
  dBands[bi][p.sex === 'female' ? 1 : 2]++;
  dSex[p.sex === 'female' ? 'f' : 'm'].push(a);
}
const dBandMax = Math.max(...dBands.map(([, f, m]) => Math.max(f, m)), 1);
const deathTotal = Math.max(deathAges.length, 1);
const pctBand = (lo, hi) => Math.round((deathAges.filter((a) => a >= lo && a < hi).length / deathTotal) * 100);
const deathNote = deathAges.length ? T.stats_death_age_note
  .replace('{n}', deathAges.length).replace('{med}', f1(_med(deathAges)))
  .replace('{p2}', pctBand(10, 15)).replace('{p3}', pctBand(15, 20)).replace('{p4}', pctBand(20, 99)) : '';
const deathNoteSex = dSex.f.length && dSex.m.length ? T.stats_death_by_sex
  .replace('{fn}', dSex.f.length).replace('{fmed}', f1(_med(dSex.f)))
  .replace('{mn}', dSex.m.length).replace('{mmed}', f1(_med(dSex.m))) : '';

// ── 長壽排行（年紀顯示到「N 歲 M 個月」）─────────────────
const link = (p) =>
  `<a class="text-rust no-underline hover:underline" href="${pandaUrl(base, locale, p.urlId)}">${displayName(p, locale)}${p.died ? deceasedHtml(locale) : ''}</a>`;
const ymStr = (a, b) => {
  let y = b.getFullYear() - a.getFullYear();
  let m = b.getMonth() - a.getMonth();
  if (b.getDate() < a.getDate()) m--;
  if (m < 0) { y--; m += 12; }
  return T.age_ym.replace('{n}', y).replace('{m}', m);
};
const oldestLiving = living
  .filter((p) => toDate(p.born))
  .map((p) => [p, ymStr(toDate(p.born), now), now - toDate(p.born)])
  .sort((a, b) => b[2] - a[2]).slice(0, 10);
const longestLived = all
  .filter((p) => p.died && toDate(p.born) && toDate(p.died))
  .map((p) => [p, ymStr(toDate(p.born), toDate(p.died)), toDate(p.died) - toDate(p.born)])
  .sort((a, b) => b[2] - a[2]).slice(0, 10);

// ── 子女數排行（♀／♂ 各前 10 含並列；子女數含所有已收錄子女）──
const topParents = (sex) => rankCut(
  all.filter((p) => p.sex === sex && (p.children || []).length > 0)
    .sort((a, b) => b.children.length - a.children.length || (a.born || '').localeCompare(b.born || '')),
  10, (p) => p.children.length);
const topMothers = topParents('female');
const topFathers = topParents('male');

// ── 配對排行（同一對父母的子女數；父母任一方存疑則不列）────
const pairCount = new Map();
for (const p of all) {
  if (!p.mother || !p.father) continue;
  const m = pandas[p.mother], f = pandas[p.father];
  if (!m || !f || m.unverified || f.unverified) continue;
  const key = p.mother + '|' + p.father;
  pairCount.set(key, (pairCount.get(key) || 0) + 1);
}
const topPairs = rankCut(
  [...pairCount.entries()]
    .map(([k, n]) => { const [m, f] = k.split('|'); return { m: pandas[m], f: pandas[f], n }; })
    .sort((a, b) => b.n - a.n || (a.m.born || '').localeCompare(b.m.born || '')),
  10, (x) => x.n);

// ── 子孫王（前 12 名含並列；只算 2 代以內：子女→孫；存疑個體不計入數字）──
//    不設上限的話永遠是資料庫最老的始祖奪冠，排行沒有鑑別度。
const DESC_DEPTH = 2;
const countDesc = (slug) => {
  const seen = new Set();
  const stack = (pandas[slug].children || []).map((s) => [s, 1]);
  while (stack.length) {
    const [s, d] = stack.pop();
    if (seen.has(s)) continue;
    seen.add(s);
    if (d < DESC_DEPTH) stack.push(...(pandas[s].children || []).map((c) => [c, d + 1]));
  }
  let n = 0;
  seen.forEach((s) => { if (!pandas[s].unverified) n++; });
  return n;
};
const topDesc = rankCut(
  all.map((p) => [p, countDesc(p.slug)]).filter(([, n]) => n > 0)
    .sort((a, b) => b[1] - a[1] || (a[0].born || '').localeCompare(b[0].born || '')),
  12, ([, n]) => n);

// ── 摘要 ──────────────────────────────────────────────
const livingAges = living.map(ageOf).filter((a) => a !== null);
const avgAge = livingAges.length ? (livingAges.reduce((s, a) => s + a, 0) / livingAges.length).toFixed(1) : '-';
const fCount = living.filter((p) => p.sex === 'female').length;
const mCount = living.filter((p) => p.sex === 'male').length;
const summary = [
  [T.stat_pandas, all.length],
  [T.stat_alive, living.length],
  [T.stats_avg_age, avgAge],
  ['♀ / ♂', `${fCount} / ${mCount}`],
];

// ── 物種（亞種）分布：兩個名稱連到 /species/ 介紹頁對應段落 ──
const spCount = { styani: 0, fulgens: 0, unknown: 0 };
for (const p of all) spCount[p.species || 'unknown']++;
const spTotal = Math.max(spCount.styani + spCount.fulgens, 1);
const speciesHref = pageUrl(base, locale, 'species');

const H2 = 'font-display text-xl font-semibold mt-9 mb-3 border-l-4 border-amber pl-2.5';
const CARD = 'card-soft p-[18px_20px]';
const ageUnit = T.stats_age_unit;
---
<h1 class="font-display text-3xl font-semibold mt-6 mb-1">{T.nav_stats}</h1>
<p class="text-ink-soft text-[.95rem] mb-5">{T.stats_intro}</p>

<!-- 摘要徽章：沿用首頁 stat-card 風格 -->
<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 my-5">
  {summary.map(([l, n]) => (
    <div class="stat-card py-4 px-2">
      <div class="text-2xl sm:text-3xl font-display font-semibold text-rust leading-none">{n}</div>
      <div class="text-[.82rem] text-ink-soft mt-1.5">{l}</div>
    </div>
  ))}
</div>

<!-- 物種（亞種）分布：連到物種介紹頁 -->
<section class="reveal">
  <h2 class={H2}>{T.field_species}</h2>
  <div class={CARD}>
    <div class="flex justify-between items-baseline gap-2 text-[.85rem] mb-1.5">
      <a class="text-rust font-medium no-underline hover:underline" href={`${speciesHref}#styani`}>
        <span class="inline-block w-2.5 h-2.5 rounded-full align-[-1px] mr-1" style="background:var(--rust)"></span>{T.subspecies_styani}（{spCount.styani}）
      </a>
      <a class="text-rust font-medium no-underline hover:underline text-right" href={`${speciesHref}#fulgens`}>
        <span class="inline-block w-2.5 h-2.5 rounded-full align-[-1px] mr-1" style="background:var(--amber)"></span>{T.subspecies_fulgens}（{spCount.fulgens}）
      </a>
    </div>
    <div class="flex h-3.5 rounded-full bg-cream overflow-hidden">
      <div class="h-full" style={`width:${(spCount.styani / spTotal) * 100}%;background:var(--rust)`}></div>
      <div class="h-full" style={`width:${(spCount.fulgens / spTotal) * 100}%;background:var(--amber)`}></div>
    </div>
    <div class="flex justify-between gap-2 text-[.8rem] text-ink-soft mt-2">
      <span>{T.stats_species_unknown.replace('{n}', spCount.unknown)}</span>
      <a class="text-rust no-underline hover:underline shrink-0" href={speciesHref}>{T.nav_species} →</a>
    </div>
  </div>
</section>

<!-- 出生寶寶數最多的動物園 -->
<section class="reveal">
  <h2 class={H2}>{T.stats_sec_birth_zoos} 🐣</h2>
  <div class={CARD}>
    {topBirth.map(([[id, n], r]) => (
      <div class="flex items-center gap-2.5 py-1">
        <span class="w-5 text-right text-ink-soft text-[.8rem] tabular-nums shrink-0">{r}</span>
        {typeof id === 'number'
          ? <a class="w-[36%] sm:w-56 shrink-0 truncate text-[.88rem] text-rust no-underline hover:underline" href={zooUrl(base, locale, zooSlugById[id])}>{zooName(id, null, locale)}</a>
          : <span class="w-[36%] sm:w-56 shrink-0 truncate text-[.88rem]">{id}</span>}
        <div class="flex-1 h-3.5 rounded-full bg-cream overflow-hidden">
          <div class="h-full rounded-full" style={`width:${Math.max((n / birthMax) * 100, 3)}%;background:var(--rust)`}></div>
        </div>
        <span class="w-7 text-right text-[.85rem] tabular-nums">{n}</span>
      </div>
    ))}
    {restBirth > 0 && (
      <div class="flex items-center gap-2.5 py-1 text-ink-soft">
        <span class="w-5 shrink-0"></span>
        <span class="w-[36%] sm:w-56 shrink-0 truncate text-[.88rem]">{T.stats_zoos_other}（{birthRank.length - topBirth.length}）</span>
        <div class="flex-1"></div>
        <span class="w-7 text-right text-[.85rem] tabular-nums">{restBirth}</span>
      </div>
    )}
  </div>
</section>

<!-- 各動物園現居頭數 -->
<section class="reveal">
  <h2 class={H2}>{T.stats_sec_zoos}</h2>
  <div class={CARD}>
    {topZoos.map(([[id, n]]) => (
      <div class="flex items-center gap-2.5 py-1">
        {typeof id === 'number'
          ? <a class="w-[38%] sm:w-56 shrink-0 truncate text-[.88rem] text-rust no-underline hover:underline" href={zooUrl(base, locale, zooSlugById[id])}>{zooName(id, null, locale)}</a>
          : <span class="w-[38%] sm:w-56 shrink-0 truncate text-[.88rem]">{id}</span>}
        <div class="flex-1 h-3.5 rounded-full bg-cream overflow-hidden">
          <div class="h-full rounded-full bg-leaf" style={`width:${Math.max((n / zooMax) * 100, 3)}%;background:var(--leaf)`}></div>
        </div>
        <span class="w-7 text-right text-[.85rem] tabular-nums">{n}</span>
      </div>
    ))}
    {restZoos > 0 && (
      <div class="flex items-center gap-2.5 py-1 text-ink-soft">
        <span class="w-[38%] sm:w-56 shrink-0 truncate text-[.88rem]">{T.stats_zoos_other}（{zooRank.length - topZoos.length}）</span>
        <div class="flex-1"></div>
        <span class="w-7 text-right text-[.85rem] tabular-nums">{restZoos}</span>
      </div>
    )}
  </div>
</section>

<!-- 每年出生數：♀ 左 ♂ 右、年份置中（與年齡分布同讀法；一年一列、最近年在最上） -->
<section class="reveal">
  <h2 class={H2}>{T.stats_sec_years}</h2>
  <div class={CARD}>
    <div class="flex justify-between text-[.8rem] mb-1.5">
      <span class="text-female font-medium">{T.sex_f}（{birthTot.f}）</span>
      <span class="text-male font-medium">{T.sex_m}（{birthTot.m}）</span>
    </div>
    {yearRecent.map(([y, fN, mN, uN, tt]) => (
      <div class="flex items-center gap-1.5 py-px text-[.72rem]" title={yearTip(y, fN, mN, uN, tt)}>
        <span class="w-6 text-right text-ink-soft tabular-nums">{fN || ''}</span>
        <div class="flex-1 flex justify-end">
          <div class="h-2.5 rounded-l-full" style={`width:${(fN / yearBandMax) * 100}%;background:var(--female);min-width:${fN ? 3 : 0}px`}></div>
        </div>
        <span class="w-9 text-center text-ink-soft tabular-nums shrink-0">{y}</span>
        <div class="flex-1">
          <div class="h-2.5 rounded-r-full" style={`width:${(mN / yearBandMax) * 100}%;background:var(--male);min-width:${mN ? 3 : 0}px`}></div>
        </div>
        <span class="w-6 text-ink-soft tabular-nums">{mN || ''}</span>
      </div>
    ))}
    {yearEarlier.length > 0 && (
      <details class="mt-1.5">
        <summary class="cursor-pointer text-rust text-[.85rem] select-none py-1">
          {T.stats_years_earlier
            .replace('{a}', yearEarlier[yearEarlier.length - 1][0])
            .replace('{b}', yearEarlier[0][0])
            .replace('{n}', earlierTot)}
        </summary>
        {yearEarlier.map(([y, fN, mN, uN, tt]) => (
          <div class="flex items-center gap-1.5 py-px text-[.72rem]" title={yearTip(y, fN, mN, uN, tt)}>
            <span class="w-6 text-right text-ink-soft tabular-nums">{fN || ''}</span>
            <div class="flex-1 flex justify-end">
              <div class="h-2.5 rounded-l-full" style={`width:${(fN / yearBandMax) * 100}%;background:var(--female);min-width:${fN ? 3 : 0}px`}></div>
            </div>
            <span class="w-9 text-center text-ink-soft tabular-nums shrink-0">{y}</span>
            <div class="flex-1">
              <div class="h-2.5 rounded-r-full" style={`width:${(mN / yearBandMax) * 100}%;background:var(--male);min-width:${mN ? 3 : 0}px`}></div>
            </div>
            <span class="w-6 text-ink-soft tabular-nums">{mN || ''}</span>
          </div>
        ))}
      </details>
    )}
    {birthTot.u > 0 && (
      <p class="text-ink-soft text-[.8rem] mt-2.5 mb-0">{T.stats_years_unknown_note.replace('{n}', birthTot.u)}</p>
    )}
  </div>
</section>

<!-- 年齡分布（現存）：♀ 左 ♂ 右的金字塔 -->
<section class="reveal">
  <h2 class={H2}>{T.stats_sec_ages}</h2>
  <div class={CARD}>
    <div class="flex justify-between text-[.8rem] mb-1.5">
      <span class="text-female font-medium">{T.sex_f}（{fCount}）</span>
      <span class="text-male font-medium">{T.sex_m}（{mCount}）</span>
    </div>
    {[...bands].reverse().map(([label, f, m]) => (
      <div class="flex items-center gap-1.5 py-[3px] text-[.78rem]">
        <span class="w-6 text-right text-ink-soft tabular-nums">{f || ''}</span>
        <div class="flex-1 flex justify-end">
          <div class="h-3.5 rounded-l-full" style={`width:${(f / bandMax) * 100}%;background:var(--female);min-width:${f ? 3 : 0}px`}></div>
        </div>
        <span class="w-14 text-center text-ink-soft whitespace-nowrap shrink-0">{label} {ageUnit}</span>
        <div class="flex-1">
          <div class="h-3.5 rounded-r-full" style={`width:${(m / bandMax) * 100}%;background:var(--male);min-width:${m ? 3 : 0}px`}></div>
        </div>
        <span class="w-6 text-ink-soft tabular-nums">{m || ''}</span>
      </div>
    ))}
  </div>
</section>

<!-- 產仔年齡：母獸／父獸並排（2026-08-15 起） -->
<section class="reveal">
  <h2 class={H2}>{T.stats_sec_parent_age}</h2>
  <div class="grid sm:grid-cols-2 gap-3">
    {[[T.stats_sec_dam_age, damSeries, damPeak, 'var(--female)', damNote, 'text-female'],
      [T.stats_sec_sire_age, sireSeries, sirePeak, 'var(--male)', sireNote, 'text-male']].map(([title, series, peak, color, note, cls]) => (
      <div class={`${CARD} min-w-0`}>
        <h3 class={`font-display text-base mt-0 mb-2 font-semibold ${cls}`}>{title}</h3>
        <div class="flex items-end gap-[3px] h-[118px]">
          {series.map(([a, n]) => (
            <div class="flex-1 h-full flex flex-col justify-end items-center" title={`${a} ${ageUnit}：${n}`}>
              <div class="w-full max-w-[18px] rounded-t" style={`height:${Math.max(Math.round((n / peak) * 110), n ? 3 : 0)}px;background:${color}`}></div>
            </div>
          ))}
        </div>
        <div class="flex gap-[3px] mt-1">
          {series.map(([a]) => (
            <span class="flex-1 text-center text-[.62rem] text-ink-soft tabular-nums">{a % 2 === 1 ? a : ''}</span>
          ))}
        </div>
        <p class="text-ink-soft text-[.8rem] mt-2.5 mb-0">{note}</p>
      </div>
    ))}
  </div>
</section>

<!-- 長壽排行 -->
<section class="reveal">
  <h2 class={H2}>{T.stats_sec_longevity}</h2>
  <div class="grid sm:grid-cols-2 gap-3">
    {[[T.stats_oldest_living, oldestLiving], [T.stats_longest_lived, longestLived]].map(([title, list]) => (
      <div class={`${CARD} min-w-0`}>
        <h3 class="font-display text-base mt-0 mb-2 font-semibold text-rust-dark">{title}</h3>
        <ol class="list-none p-0 m-0">
          {list.map(([p, a], i) => (
            <li class="py-1 flex items-baseline gap-2 border-t border-line first:border-t-0 text-[.92rem]">
              <span class="w-5 text-right text-ink-soft text-[.82rem] tabular-nums shrink-0">{i + 1}</span>
              <span class="min-w-0 flex-1 truncate" set:html={link(p)} />
              <span class="text-ink-soft text-[.85rem] whitespace-nowrap">{a}</span>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
</section>

<!-- 歿齡分布：♀ 左 ♂ 右金字塔（2026-08-15 起分性別）。⚠️ 歿齡組成，非存活率（見註腳） -->
<section class="reveal">
  <h2 class={H2}>{T.stats_sec_death_age}</h2>
  <div class={CARD}>
    <div class="flex justify-between text-[.8rem] mb-1.5">
      <span class="text-female font-medium">{T.sex_f}（{dSex.f.length}）</span>
      <span class="text-male font-medium">{T.sex_m}（{dSex.m.length}）</span>
    </div>
    {[...dBands].reverse().map(([label, fN, mN]) => (
      <div class="flex items-center gap-1.5 py-[3px] text-[.78rem]">
        <span class="w-6 text-right text-ink-soft tabular-nums">{fN || ''}</span>
        <div class="flex-1 flex justify-end">
          <div class="h-3.5 rounded-l-full" style={`width:${(fN / dBandMax) * 100}%;background:var(--female);min-width:${fN ? 3 : 0}px`}></div>
        </div>
        <span class="w-14 text-center text-ink-soft whitespace-nowrap shrink-0">{label} {ageUnit}</span>
        <div class="flex-1">
          <div class="h-3.5 rounded-r-full" style={`width:${(mN / dBandMax) * 100}%;background:var(--male);min-width:${mN ? 3 : 0}px`}></div>
        </div>
        <span class="w-6 text-ink-soft tabular-nums">{mN || ''}</span>
      </div>
    ))}
    <p class="text-ink-soft text-[.8rem] mt-2.5 mb-0">{deathNote} {deathNoteSex}</p>
  </div>
</section>

<!-- 子女數排行 -->
<section class="reveal">
  <h2 class={H2}>{T.stats_sec_children}</h2>
  <div class="grid sm:grid-cols-2 gap-3">
    {[[T.stats_top_mothers, topMothers, 'text-female'], [T.stats_top_fathers, topFathers, 'text-male']].map(([title, list, cls]) => (
      <div class={`${CARD} min-w-0`}>
        <h3 class={`font-display text-base mt-0 mb-2 font-semibold ${cls}`}>{title}</h3>
        <ol class="list-none p-0 m-0">
          {list.map(([p, r]) => (
            <li class="py-1 flex items-baseline gap-2 border-t border-line first:border-t-0 text-[.92rem]">
              <span class="w-5 text-right text-ink-soft text-[.82rem] tabular-nums shrink-0">{r}</span>
              <span class="min-w-0 flex-1 truncate" set:html={link(p)} />
              <span class="text-ink-soft text-[.85rem] whitespace-nowrap">{T.stats_kids_n.replace('{n}', p.children.length)}</span>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </div>
</section>

<!-- 配對排行 -->
<section class="reveal">
  <h2 class={H2}>{T.stats_sec_pairs}</h2>
  <div class={CARD}>
    <ol class="list-none p-0 m-0">
      {topPairs.map(([{ m, f, n }, r]) => (
        <li class="py-1 flex items-baseline gap-2 border-t border-line first:border-t-0 text-[.92rem]">
          <span class="w-5 text-right text-ink-soft text-[.82rem] tabular-nums shrink-0">{r}</span>
          <span class="min-w-0 flex-1 truncate">
            <span class="text-female">♀</span> <Fragment set:html={link(m)} />
            <span class="text-ink-soft mx-1">×</span>
            <span class="text-male">♂</span> <Fragment set:html={link(f)} />
          </span>
          <span class="text-ink-soft text-[.85rem] whitespace-nowrap">{T.stats_kids_n.replace('{n}', n)}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- 子孫王排行 -->
<section class="reveal">
  <h2 class={H2}>{T.stats_sec_descendants}</h2>
  <div class={CARD}>
    <ol class="list-none p-0 m-0">
      {topDesc.map(([[p, n], r]) => (
        <li class="py-1 flex items-baseline gap-2 border-t border-line first:border-t-0 text-[.92rem]">
          <span class="w-5 text-right text-ink-soft text-[.82rem] tabular-nums shrink-0">{r}</span>
          <span class={`shrink-0 ${p.sex === 'female' ? 'text-female' : p.sex === 'male' ? 'text-male' : 'text-ink-soft'}`}>{p.sex === 'female' ? '♀' : p.sex === 'male' ? '♂' : '?'}</span>
          <span class="min-w-0 flex-1 truncate" set:html={link(p)} />
          <span class="text-ink-soft text-[.85rem] whitespace-nowrap">{T.stats_desc_n.replace('{n}', n)}</span>
        </li>
      ))}
    </ol>
    <p class="text-ink-soft text-[.8rem] mt-2 mb-0">{T.stats_desc_note}</p>
  </div>
</section>

<p class="text-ink-soft text-[.82rem] mt-6">{T.stats_note}</p>
<p class="text-[.85rem] mt-2"><a class="text-rust no-underline hover:underline" href={pageUrl(base, locale, 'moves')}>{T.nav_moves} →</a>{SHOW_REVIEW && (
  <Fragment><span class="text-ink-soft mx-2">·</span><a class="text-rust no-underline hover:underline" href={pageUrl(base, locale, 'review')}>{T.rv_title} →</a></Fragment>
)}</p>
