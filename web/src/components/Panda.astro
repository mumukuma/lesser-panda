          <li class="flex gap-2 items-baseline min-w-0">
            <span aria-hidden="true" class="shrink-0">🔒</span>
            <a href={u} target="_blank" rel="noopener" class="text-rust hover:underline break-all min-w-0">{devSrcLabel(u)}</a>
            <span class="shrink-0 text-ink-soft text-[.75rem]">僅 dev 顯示</span>
          </li>
        ))}
      </ul>
      <p class="text-ink-soft text-[.82rem] mt-2">{T.sources_note}</p>
    </div>
  </>
)}

{extraSources.length > 0 && (
  <>
    <h2 class={H3}>{T.sec_extra_sources}</h2>
    <div class={`${CARD} reveal`}>
      <ul class="m-0 p-0 list-none space-y-1.5">
        {extraSources.map((s) => (
          <li class="flex gap-2 items-baseline min-w-0">
            <span aria-hidden="true" class="shrink-0 text-ink-soft">📎</span>
            <a href={s.raw} target="_blank" rel="noopener nofollow" class="text-rust hover:underline break-all min-w-0">{s.label}</a>
          </li>
        ))}
      </ul>
      <p class="text-ink-soft text-[.82rem] mt-2">{T.extra_sources_note}</p>
    </div>
  </>
)}

{/* 投稿 CTA：一律顯示（零照片的個體最需要投稿）。點按鈕才載入 Tally embed，panda/slug/url 預填。 */}
{photoEmbedSrc && (
  <>
    {mediaCount === 0 && <h2 class={H3}>{T.sec_photos}</h2>}
    <div class="card-soft p-4 mt-3 text-center reveal">
      <p class="m-0 text-[.95rem] text-ink-soft" set:html={T.photos_cta.replace('{name}', `<span class="text-rust font-medium">${primary}</span>`)} />
      <p class="mt-3 mb-0 mx-auto max-w-md text-[.82rem] font-semibold text-rust-dark rounded-input px-3 py-2 border-2 border-amber"
        style="background: color-mix(in srgb, var(--amber) 15%, transparent);">{T.photos_consent}</p>
      <button type="button" id="photo-toggle" aria-expanded="false" aria-controls="photo-panel"
        class="pop mt-2.5 bg-rust text-white rounded-full px-4 py-2 text-[.9rem] border-0 cursor-pointer">📷 {T.photos_cta_btn}</button>
      <div id="photo-panel" hidden class="mt-3 text-left"></div>
    </div>
    <script is:inline define:vars={{ src: photoEmbedSrc, title: T.photos_cta_btn }}>
      (function () {
        var btn = document.getElementById('photo-toggle');
        var panel = document.getElementById('photo-panel');
        if (!btn || !panel) return;
        var loaded = false;
        btn.addEventListener('click', function () {
          if (panel.hasAttribute('hidden')) {
            panel.removeAttribute('hidden');
            btn.setAttribute('aria-expanded', 'true');
            if (!loaded) {
              var f = document.createElement('iframe');
              f.setAttribute('data-tally-src', src);
              f.setAttribute('loading', 'lazy');
              f.width = '100%'; f.height = '500';
              f.frameBorder = '0'; f.marginHeight = '0'; f.marginWidth = '0';
              f.title = title;
              panel.appendChild(f);
              if (window.Tally) {
                window.Tally.loadEmbeds();
              } else {
                var s = document.createElement('script');
                s.src = 'https://tally.so/widgets/embed.js';
                document.body.appendChild(s);
              }
              loaded = true;
            }
          } else {
            panel.setAttribute('hidden', '');
            btn.setAttribute('aria-expanded', 'false');
          }
        });
      })();
    </script>
  </>
)}
